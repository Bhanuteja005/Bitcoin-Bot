# Copy to .env and fill in. .env is gitignored. NEVER paste these values into chat.

# --- mode: paper by default. Live needs BOTH lines below. ---
PM_MODE=dry_run
PM_LIVE_CONFIRMED=false

# --- wallet (only needed for live) ---
# Polymarket email login: Settings -> "Export private key". MetaMask login: that wallet's key.
PM_PRIVATE_KEY=
# The address shown on your Polymarket profile / deposit page (the wallet that holds your funds).
# Required: without it the SDK would try to deploy a new wallet on-chain.
PM_FUNDER_ADDRESS=

# --- risk mandate (defaults shown) ---
PM_BANKROLL_USD=1.0          # paper-mode starting cash
PM_MAX_STAKE_USD=1.0
PM_DAILY_LOSS_LIMIT_USD=1.0
PM_MAX_TRADES_PER_DAY=20
PM_MIN_EDGE=0.04
PM_MAX_ENTRY_PRICE=0.90
PM_MIN_ENTRY_PRICE=0.40
PM_MIN_SECONDS_LEFT=15
PM_SLIPPAGE=0.02
PM_STOP_FAIR=0.25             # stop-loss: sell once our side's chance of winning is <= 25%
PM_STOP_MIN_BID=0.03          # ...unless the bid is below 3c (nothing left to save)
PM_STOP_LOSS_PCT=0             # autopilot: sell once the bid is this share below entry (0.40 = -40%)
PM_KELLY_FRACTION=0.25        # stake = quarter of the Kelly bet
PM_MAX_BANKROLL_FRAC=0.25     # never more than 25% of cash on one trade
PM_BLACKOUT_ET=08:25-08:45,13:55-14:45   # no entries around US macro releases (New York time)
PM_ENTRY_ZONE_S=150          # autopilot looks for entries only in the last N seconds
PM_SETTLE_WINDOWS=60,300     # close readings a trade must work under (60s tail, full 5-min window)

# --- auto-claim of winnings (live): Polymarket builder key ---
PM_BUILDER_API_KEY=
PM_BUILDER_SECRET=
PM_BUILDER_PASSPHRASE=

# --- where the journal lives (Railway: the volume mount) ---
# PM_DATA_DIR=/data
